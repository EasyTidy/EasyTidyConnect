# wechat-signer 配置。复制为 wechat-signer.env 后填写，权限建议 600（只有服务用户可读）。

# 公众号 AppID（公众号后台 → 设置与开发 → 基本配置）
WECHAT_APP_ID=wx0000000000000000

# 公众号 AppSecret；也可以改用 WECHAT_APP_SECRET_FILE 指向只包含密钥的文件
WECHAT_APP_SECRET=
# WECHAT_APP_SECRET_FILE=/run/secrets/wechat_app_secret

# 允许签名的页面域名，逗号分隔，包含子域名。应与公众号「JS 接口安全域名」一致
WECHAT_ALLOWED_DOMAINS=love.example.com

# 监听地址。前面有 Caddy / Nginx 时建议只监听本机
WECHAT_LISTEN=127.0.0.1:8080

# access_token 接口：stable（默认，不影响同一公众号其他系统的 token）或 classic
WECHAT_TOKEN_API=stable

# 日志级别：error / warn / info / debug
RUST_LOG=info
